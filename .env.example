# Kopier denne fila til .env (cp .env.example .env). .env står i .gitignore.
# lib/env.ts validerer variablene når appen starter.

# Lokal Supabase (npx supabase start). Adressen og den offentlige nøkkelen er
# standardverdiene til Supabase CLI og er like på alle maskiner. Sjekk dem med
# `npx supabase status` (API_URL og PUBLISHABLE_KEY). De er ikke hemmelige.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# KI-forslag. mock er standard og trenger ingen nøkkel.
# Med AI_PROVIDER=openai er de tre neste påkrevd (OpenAI-kompatibelt API).
# Legg aldri en ekte nøkkel i denne fila, bare i .env.
AI_PROVIDER=mock
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
