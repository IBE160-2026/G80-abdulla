{
  "name": "localfix",
  "private": true,
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:db && npm run test:e2e",
    "test:unit": "vitest run --configLoader runner --project unit",
    "test:db": "npx supabase db reset && node scripts/db-types.mjs --check && npx supabase test db && vitest run --configLoader runner --project db",
    "test:e2e": "playwright test",
    "eval:sm5": "vitest run --configLoader runner --project sm5 --reporter=verbose",
    "db:types": "node scripts/db-types.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.511.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@next/env": "16.4.5",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "8.5.32",
    "supabase": "2.122.1",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "type-fest": "5.10.0",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.0.5"
  }
}
